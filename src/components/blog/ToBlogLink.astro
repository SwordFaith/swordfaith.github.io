---
import type { CollectionEntry } from 'astro:content';
import { getPermalink } from '@/utils/site-config';
import { getBlogPermalink } from '@/utils/site-config';

export interface Props {
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { previousPost, nextPost } = Astro.props;
---

<nav class="mt-12 border-t border-gray-200 pt-8 dark:border-slate-700" aria-label="上一篇和下一篇文章">
  <div class="grid gap-4 sm:grid-cols-2">
    {previousPost && (
      <a href={getPermalink(previousPost.id, 'post')} class="group rounded-xl border border-gray-200 p-4 transition-colors hover:border-primary dark:border-slate-700 dark:hover:border-primary" rel="prev">
        <span class="mb-1 block text-sm text-muted">上一篇</span>
        <span class="font-medium text-page group-hover:text-primary">{previousPost.data.title}</span>
      </a>
    )}
    {nextPost && (
      <a
        href={getPermalink(nextPost.id, 'post')}
        class:list={[
          'group rounded-xl border border-gray-200 p-4 text-left transition-colors hover:border-primary dark:border-slate-700 dark:hover:border-primary sm:text-right',
          { 'sm:col-start-2': !previousPost },
        ]}
        rel="next"
      >
        <span class="mb-1 block text-sm text-muted">下一篇</span>
        <span class="font-medium text-page group-hover:text-primary">{nextPost.data.title}</span>
      </a>
    )}
  </div>
</nav>

<div class="mt-6 text-center">
  <a href={getBlogPermalink()} class="btn btn-tertiary px-3">
    <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg>
    返回博客列表
  </a>
</div>
