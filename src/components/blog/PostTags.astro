---
import { getTagPath, getUniqueTags } from '@/utils/tags';

export interface Props {
  tags?: string[];
  class?: string;
}

const { tags = [], class: className = '' } = Astro.props;
const uniqueTags = getUniqueTags(tags);
---

{uniqueTags.length > 0 && (
  <div class={`flex flex-wrap gap-2 ${className}`} aria-label="文章标签">
    {uniqueTags.map((tag) => (
      <a
        href={getTagPath(tag)}
        class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700 transition-colors hover:bg-primary-100 dark:bg-primary-900/25 dark:text-primary-300 dark:hover:bg-primary-900/40"
        aria-label={`查看标签 ${tag} 的文章`}
      >
        {tag}
      </a>
    ))}
  </div>
)}
