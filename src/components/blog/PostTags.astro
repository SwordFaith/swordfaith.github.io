---
export interface Props {
  tags?: string[];
  class?: string;
}

const { tags = [], class: className = '' } = Astro.props;
---

{tags.length > 0 && (
  <div class={`flex flex-wrap gap-2 ${className}`} aria-label="文章标签">
    {tags.map((tag) => <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700 dark:bg-primary-900/25 dark:text-primary-300">{tag}</span>)}
  </div>
)}
