---
import type { CollectionEntry } from 'astro:content';
import PostTags from '@/components/blog/PostTags.astro';
import ToBlogLink from '@/components/blog/ToBlogLink.astro';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const wandbUrl = post.data.wandb?.projectId && post.data.wandb?.runId
  ? `https://wandb.ai/${post.data.wandb.projectId}/runs/${post.data.wandb.runId}`
  : undefined;
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
  <header class="mb-10 text-center">
    <div class="mb-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-muted">
      <time datetime={post.data.publishDate.toISOString()}>
        {post.data.publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <span aria-hidden="true">·</span>
      <span>{post.data.author}</span>
      {post.data.updateDate && (
        <span>更新于 {post.data.updateDate.toLocaleDateString('zh-CN')}</span>
      )}
    </div>
    <h1 class="heading-tighter mb-5 text-4xl text-page md:text-5xl">{post.data.title}</h1>
    {post.data.description && <p class="mx-auto mb-6 max-w-2xl text-xl leading-relaxed text-muted">{post.data.description}</p>}
    <PostTags tags={post.data.tags} class="justify-center" />
  </header>

  {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="mb-10 w-full rounded-2xl shadow-lg" />}

  <div class="prose prose-lg mx-auto max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-pre:bg-slate-900 prose-pre:text-slate-100">
    <slot />
  </div>

  {wandbUrl && (
    <section class="mt-12 rounded-2xl border border-gray-200 bg-gray-50 p-5 dark:border-slate-700 dark:bg-slate-900" aria-labelledby="wandb-title">
      <h2 id="wandb-title" class="mb-4 text-xl font-semibold text-page">相关实验结果</h2>
      <iframe src={wandbUrl} title="WandB 实验结果" width="100%" height="400" class="rounded-lg border-0 bg-white dark:bg-slate-950" loading="lazy"></iframe>
    </section>
  )}

  <ToBlogLink />
</article>
