---
import type { CollectionEntry } from 'astro:content';
import PostTags from '@/components/blog/PostTags.astro';
import { getPermalink } from '@/utils/site-config';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const permalink = getPermalink(post.id, 'post');
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-900">
  {post.data.cover && (
    <a href={permalink} class="block aspect-[16/9] overflow-hidden" tabindex="-1" aria-hidden="true">
      <img src={post.data.cover} alt="" class="h-full w-full object-cover group-hover:scale-105" loading="lazy" />
    </a>
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-center gap-2 text-sm text-muted">
      <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('zh-CN')}</time>
      <span aria-hidden="true">·</span>
      <span>{post.data.author}</span>
    </div>
    <h3 class="mb-3 text-xl font-bold leading-snug text-page">
      <a href={permalink} class="hover:text-primary">{post.data.title}</a>
    </h3>
    {post.data.description && <p class="mb-5 line-clamp-3 leading-relaxed text-muted">{post.data.description}</p>}
    <PostTags tags={post.data.tags.slice(0, 3)} class="mt-auto" />
  </div>
</article>
