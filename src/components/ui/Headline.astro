---
export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  titleTag?: 'h1' | 'h2';
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  subtitle,
  tagline,
  titleTag = 'h2',
  align = 'center',
  class: className = ''
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center'
};

const containerClasses = [
  alignClasses[align],
  className
].filter(Boolean).join(' ');
const TitleTag = titleTag;
---

{(title || subtitle || tagline) && (
  <div class={containerClasses}>
    {tagline && (
      <p class="tagline mb-2">
        {tagline}
      </p>
    )}
    {title && (
      <TitleTag class="heading-section mb-4">
        <Fragment set:html={title} />
      </TitleTag>
    )}
    {subtitle && (
      <p class="text-xl text-muted max-w-3xl mx-auto">
        <Fragment set:html={subtitle} />
      </p>
    )}
  </div>
)}
