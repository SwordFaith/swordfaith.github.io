---
import Button from '@/components/ui/Button.astro';
import WidgetWrapper from '@/components/ui/WidgetWrapper.astro';

interface Action {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
  target?: string;
}

export interface Props {
  tagline?: string;
  title: string;
  subtitle?: string;
  actions?: Action[];
  compact?: boolean;
}

const { tagline, title, subtitle, actions = [], compact = false } = Astro.props;
---

<WidgetWrapper padding={compact ? 'lg' : 'xl'} class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-80 max-w-4xl rounded-full bg-primary-100/50 blur-3xl dark:bg-primary-900/20" aria-hidden="true"></div>
  <div class="mx-auto max-w-4xl text-center">
    <slot name="image" />
    {tagline && <p class="tagline mb-4">{tagline}</p>}
    <h1 class:list={['heading-tighter mb-6 text-page', compact ? 'text-4xl md:text-5xl' : 'heading-primary']}>{title}</h1>
    {subtitle && <p class="mx-auto mb-8 max-w-2xl text-xl leading-relaxed text-muted">{subtitle}</p>}
    {actions.length > 0 && (
      <div class="flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
        {actions.map((action) => (
          <Button variant={action.variant || 'primary'} size="lg" href={action.href} target={action.target}>
            {action.text}
          </Button>
        ))}
      </div>
    )}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</WidgetWrapper>
