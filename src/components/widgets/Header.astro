---
import { headerData } from '@/navigation';
import Logo from '@/components/widgets/Logo.astro';
import ToggleMenu from '@/components/widgets/ToggleMenu.astro';
import ToggleTheme from '@/components/widgets/ToggleTheme.astro';
import SearchBox from '@/components/search/SearchBox.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="glass-effect sticky top-0 z-50 border-b border-gray-200/80 dark:border-slate-700/80" data-aw-header>
  <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo />
    <div class="flex items-center gap-1">
      <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
        {headerData.links.map(({ text, href }) => (
          <a
            href={href}
            class:list={[
              'rounded-lg px-4 py-2 text-sm font-medium hover:bg-gray-100 hover:text-page dark:hover:bg-slate-800',
              isActive(href) ? 'text-primary' : 'text-muted',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {text}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="hidden h-10 w-10 items-center justify-center rounded-lg text-muted hover:bg-gray-100 hover:text-page focus:outline-none focus:ring-2 focus:ring-primary-500 dark:hover:bg-slate-800 md:inline-flex"
        aria-label="打开搜索"
        aria-expanded="false"
        aria-controls="header-search-panel"
        title="搜索"
        data-aw-toggle-search
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
      </button>
      <ToggleTheme />
      <ToggleMenu />
    </div>
  </div>
  <div id="header-search-panel" class="hidden border-t border-gray-200 dark:border-slate-700" data-aw-search-panel>
    <div class="mx-auto max-w-3xl px-4 py-4 sm:px-6">
      <SearchBox id="header-search" />
    </div>
  </div>
  <nav id="primary-navigation" class="hidden border-t border-gray-200 px-4 py-3 dark:border-slate-700 md:hidden" aria-label="移动端导航" data-aw-navigation>
    <div class="mx-auto flex max-w-7xl flex-col gap-1">
      <SearchBox id="mobile-search" className="mb-2" />
      {headerData.links.map(({ text, href }) => (
        <a
          href={href}
          class:list={[
            'rounded-lg px-3 py-3 font-medium hover:bg-gray-100 hover:text-page dark:hover:bg-slate-800',
            isActive(href) ? 'bg-primary-50 text-primary dark:bg-primary-900/20' : 'text-muted',
          ]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {text}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-aw-header]').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('[data-aw-toggle-menu]');
    const navigation = header.querySelector<HTMLElement>('[data-aw-navigation]');
    const searchButton = header.querySelector<HTMLButtonElement>('[data-aw-toggle-search]');
    const searchPanel = header.querySelector<HTMLElement>('[data-aw-search-panel]');
    if (!button || !navigation) return;

    const dismissPanelSearch = (panel: HTMLElement) => {
      panel.querySelector('[data-search-root]')?.dispatchEvent(new Event('search:dismiss'));
    };

    const setMenuOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      if (!open) dismissPanelSearch(navigation);
      navigation.classList.toggle('hidden', !open);
    };

    const setSearchOpen = (open: boolean) => {
      if (!searchButton || !searchPanel) return;
      searchButton.setAttribute('aria-expanded', String(open));
      searchButton.setAttribute('aria-label', open ? '关闭搜索' : '打开搜索');
      if (!open) dismissPanelSearch(searchPanel);
      searchPanel.classList.toggle('hidden', !open);
      if (open) {
        setMenuOpen(false);
        requestAnimationFrame(() => searchPanel.querySelector<HTMLInputElement>('[data-search-input]')?.focus());
      }
    };

    button.addEventListener('click', () => {
      setSearchOpen(false);
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    searchButton?.addEventListener('click', () => setSearchOpen(searchButton.getAttribute('aria-expanded') !== 'true'));
    navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !event.defaultPrevented && !event.isComposing) {
        if (button.getAttribute('aria-expanded') === 'true') {
          event.preventDefault();
          setMenuOpen(false);
          button.focus();
        } else if (searchButton?.getAttribute('aria-expanded') === 'true') {
          event.preventDefault();
          setSearchOpen(false);
          searchButton.focus();
        }
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
      else setSearchOpen(false);
    });
  });
</script>
