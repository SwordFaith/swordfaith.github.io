---
import { Marked } from 'marked';
import { markedHighlight } from 'marked-highlight';
import hljs from 'highlight.js';
import { serialize } from 'parse5';
import { notebookMath, renderNotebookMath } from '@/utils/notebook-math';
import {
  sanitizeNotebookFragment,
  type ParsedCell,
  type ParsedNotebook,
} from '@/utils/notebook-parser';

export interface Props {
  notebook: ParsedNotebook;
  title?: string;
  sourceUrl?: string;
  showExecutionCount?: boolean;
  showMetadata?: boolean;
}

const {
  notebook,
  title = notebook.title,
  sourceUrl,
  showExecutionCount = true,
  showMetadata = false,
} = Astro.props;

const markdown = new Marked(notebookMath);
markdown.use(markedHighlight({
  langPrefix: 'hljs language-',
  highlight(code, lang) {
    const language = lang && hljs.getLanguage(lang) ? lang : 'plaintext';
    return hljs.highlight(code, { language }).value;
  },
}));

function renderMarkdown(cell: ParsedCell): string {
  const html = markdown.parse(cell.source, { async: false });
  const fragment = sanitizeNotebookFragment(html, cell.attachments);
  renderNotebookMath(fragment);
  return serialize(fragment);
}

const kernelName = notebook.metadata.kernelspec?.display_name
  || notebook.metadata.language_info?.name
  || 'Unknown kernel';
---

<div class="notebook-viewer">
  <header class="notebook-header">
    <h1 class="text-3xl font-bold text-page mb-3">{title}</h1>
    <div class="notebook-summary">
      <span>Jupyter Notebook</span>
      <span>{notebook.cells.length} cells</span>
      <span>{kernelName}</span>
      {notebook.executionCount > 0 && <span>{notebook.executionCount} executed</span>}
    </div>
    {sourceUrl && (
      <div class="source-actions">
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">查看源文件</a>
        <a href={sourceUrl} download>下载 .ipynb</a>
      </div>
    )}
  </header>

  <div class="notebook-cells">
    {notebook.cells.map((cell) => (
      <section class={`notebook-cell cell-${cell.type}`} id={cell.id}>
        {cell.type === 'code' && (
          <div class="code-cell">
            <div class="code-input">
              <div class="input-header">
                {showExecutionCount && (
                  <span class="execution-count">In [{cell.executionCount ?? ' '}]:</span>
                )}
                <button class="copy-button" type="button" data-code={cell.source}>
                  <span class="copy-label">Copy</span>
                </button>
              </div>
              <pre class="code-content"><code>{cell.source}</code></pre>
            </div>

            {cell.outputs.length > 0 && (
              <div class="code-output">
                <div class="output-header">Output:</div>
                <div class="output-content">
                  {cell.outputs.map((output) => (
                    <div class={`output-item output-${output.type}`}>
                      {output.type === 'text' && (
                        <pre class="output-text" data-stream={output.streamName}>{output.content}</pre>
                      )}
                      {output.type === 'html' && (
                        <div
                          class="output-html prose prose-sm max-w-none dark:prose-invert dark:prose-dark"
                          set:html={output.content}
                        />
                      )}
                      {output.type === 'image' && (
                        <img
                          class="output-image"
                          src={`data:${output.mimeType};base64,${output.content}`}
                          alt="Notebook output"
                          loading="lazy"
                        />
                      )}
                      {output.type === 'json' && (
                        <pre class="output-json">{output.content}</pre>
                      )}
                      {output.type === 'error' && (
                        <pre class="output-error">{output.content}</pre>
                      )}
                      {output.type === 'unsupported' && (
                        <p class="output-unsupported">{output.content}</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        {cell.type === 'markdown' && (
          <div
            class="markdown-content prose prose-lg max-w-none dark:prose-invert dark:prose-dark prose-pre:bg-slate-900 prose-pre:text-slate-100"
            set:html={renderMarkdown(cell)}
          />
        )}

        {cell.type === 'raw' && <pre class="raw-content">{cell.source}</pre>}
      </section>
    ))}
  </div>

  {showMetadata && (
    <details class="notebook-metadata">
      <summary>Notebook Metadata</summary>
      <pre>{JSON.stringify(notebook.metadata, null, 2)}</pre>
    </details>
  )}
</div>

<style>
  .notebook-viewer {
    @apply max-w-4xl mx-auto;
  }

  .notebook-header {
    @apply mb-8;
  }

  .notebook-summary {
    @apply flex flex-wrap gap-x-4 gap-y-2 text-sm;
    color: var(--aw-color-text-muted);
  }

  .source-actions {
    @apply flex flex-wrap gap-4 mt-4 text-sm font-medium;
  }

  .source-actions a {
    @apply underline underline-offset-4;
    color: var(--aw-color-link);
  }

  .source-actions a:hover {
    color: var(--aw-color-link-hover);
  }

  .notebook-cells {
    @apply space-y-4;
  }

  .notebook-cell {
    @apply border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900;
  }

  .cell-code {
    @apply border-l-4 border-l-blue-500 dark:border-l-blue-400;
  }

  .cell-markdown {
    @apply border-l-4 border-l-green-500 dark:border-l-green-400;
  }

  .cell-raw {
    @apply border-l-4 border-l-gray-500 dark:border-l-slate-500;
  }

  .input-header,
  .output-header {
    @apply flex items-center justify-between px-4 py-2 bg-gray-50 border-b border-gray-200 dark:bg-slate-800 dark:border-slate-700;
  }

  .execution-count,
  .output-header {
    @apply text-sm font-mono text-blue-600 dark:text-blue-400;
  }

  .copy-button {
    @apply px-2 py-1 text-xs;
    color: var(--aw-color-text-muted);
  }

  .copy-button:hover {
    color: var(--aw-color-text-page);
  }

  .code-content {
    @apply p-4 bg-gray-50 text-sm font-mono leading-relaxed overflow-x-auto whitespace-pre dark:bg-slate-950;
  }

  .output-content {
    @apply p-4 space-y-3;
  }

  /* Wrapper divs carry the same output-<type> class, so target only the inner element. */
  .output-item > .output-text,
  .output-item > .output-json {
    @apply text-sm font-mono bg-gray-100 p-3 rounded whitespace-pre-wrap overflow-x-auto dark:bg-slate-800;
  }

  /* Prose classes live in the template: scoped @apply rules cannot reach set:html descendants.
     prose-dark carries the site's dark overrides for colors the typography config hard-codes. */
  .output-item > .output-html {
    @apply overflow-x-auto;
  }

  /* Plots are often rendered with transparent backgrounds and dark axes; keep them on white. */
  .output-item > .output-image {
    @apply max-w-full h-auto rounded border border-gray-200 bg-white dark:border-slate-700;
  }

  /* Same backdrop for images inside set:html content, which lacks the scoping attribute. */
  :global(.dark) .markdown-content :global(img),
  :global(.dark) .output-html :global(img) {
    background-color: rgb(255 255 255);
  }

  .output-item > .output-error {
    @apply text-sm font-mono text-red-800 bg-red-50 border border-red-200 rounded p-3 whitespace-pre-wrap overflow-x-auto dark:text-red-300 dark:bg-red-950/40 dark:border-red-900;
  }

  .output-item > .output-unsupported {
    @apply text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded p-3 dark:text-amber-300 dark:bg-amber-950/40 dark:border-amber-900;
  }

  .markdown-content {
    @apply p-6 text-gray-800 dark:text-gray-300;
  }

  .markdown-content :global(.katex-display) {
    @apply my-4 overflow-x-auto overflow-y-hidden py-2;
  }

  .raw-content {
    @apply p-4 bg-gray-50 text-sm font-mono text-gray-700 whitespace-pre-wrap overflow-x-auto dark:bg-slate-950 dark:text-slate-300;
  }

  .notebook-metadata {
    @apply mt-8 p-4 bg-gray-50 rounded-lg text-sm dark:bg-slate-900;
  }

  .notebook-metadata pre {
    @apply mt-3 overflow-x-auto;
  }

  @media (max-width: 768px) {
    .code-content,
    .output-item > .output-text,
    .output-item > .output-json,
    .output-item > .output-error {
      @apply text-xs;
    }

    .markdown-content {
      @apply p-4;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLSpanElement>('.copy-label');
      try {
        await navigator.clipboard.writeText(button.dataset.code ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  });
</script>
