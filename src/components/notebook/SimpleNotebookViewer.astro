---
import { Marked } from 'marked';
import { markedHighlight } from 'marked-highlight';
import hljs from 'highlight.js';
import {
  sanitizeNotebookHtml,
  type ParsedNotebook,
} from '@/utils/notebook-parser';

export interface Props {
  notebook: ParsedNotebook;
  title?: string;
  sourceUrl?: string;
  showExecutionCount?: boolean;
  showMetadata?: boolean;
}

const {
  notebook,
  title = notebook.title,
  sourceUrl,
  showExecutionCount = true,
  showMetadata = false,
} = Astro.props;

const markdown = new Marked();
markdown.use(markedHighlight({
  langPrefix: 'hljs language-',
  highlight(code, lang) {
    const language = lang && hljs.getLanguage(lang) ? lang : 'plaintext';
    return hljs.highlight(code, { language }).value;
  },
}));

function renderMarkdown(source: string): string {
  return sanitizeNotebookHtml(markdown.parse(source, { async: false }));
}

const kernelName = notebook.metadata.kernelspec?.display_name
  || notebook.metadata.language_info?.name
  || 'Unknown kernel';
---

<div class="notebook-viewer">
  <header class="notebook-header">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">{title}</h1>
    <div class="notebook-summary">
      <span>Jupyter Notebook</span>
      <span>{notebook.cells.length} cells</span>
      <span>{kernelName}</span>
      {notebook.executionCount > 0 && <span>{notebook.executionCount} executed</span>}
    </div>
    {sourceUrl && (
      <div class="source-actions">
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">查看源文件</a>
        <a href={sourceUrl} download>下载 .ipynb</a>
      </div>
    )}
  </header>

  <div class="notebook-cells">
    {notebook.cells.map((cell) => (
      <section class={`notebook-cell cell-${cell.type}`} id={cell.id}>
        {cell.type === 'code' && (
          <div class="code-cell">
            <div class="code-input">
              <div class="input-header">
                {showExecutionCount && (
                  <span class="execution-count">In [{cell.executionCount ?? ' '}]:</span>
                )}
                <button class="copy-button" type="button" data-code={cell.source}>
                  <span class="copy-label">Copy</span>
                </button>
              </div>
              <pre class="code-content"><code>{cell.source}</code></pre>
            </div>

            {cell.outputs.length > 0 && (
              <div class="code-output">
                <div class="output-header">Output:</div>
                <div class="output-content">
                  {cell.outputs.map((output) => (
                    <div class={`output-item output-${output.type}`}>
                      {output.type === 'text' && (
                        <pre class="output-text" data-stream={output.streamName}>{output.content}</pre>
                      )}
                      {output.type === 'html' && (
                        <div class="output-html" set:html={output.content} />
                      )}
                      {output.type === 'image' && (
                        <img
                          class="output-image"
                          src={`data:${output.mimeType};base64,${output.content}`}
                          alt="Notebook output"
                          loading="lazy"
                        />
                      )}
                      {output.type === 'json' && (
                        <pre class="output-json">{output.content}</pre>
                      )}
                      {output.type === 'error' && (
                        <pre class="output-error">{output.content}</pre>
                      )}
                      {output.type === 'unsupported' && (
                        <p class="output-unsupported">{output.content}</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        {cell.type === 'markdown' && (
          <div
            class="markdown-content prose prose-lg max-w-none"
            set:html={renderMarkdown(cell.source)}
          />
        )}

        {cell.type === 'raw' && <pre class="raw-content">{cell.source}</pre>}
      </section>
    ))}
  </div>

  {showMetadata && (
    <details class="notebook-metadata">
      <summary>Notebook Metadata</summary>
      <pre>{JSON.stringify(notebook.metadata, null, 2)}</pre>
    </details>
  )}
</div>

<style>
  .notebook-viewer {
    @apply max-w-4xl mx-auto;
  }

  .notebook-header {
    @apply mb-8;
  }

  .notebook-summary {
    @apply flex flex-wrap gap-x-4 gap-y-2 text-sm text-gray-600;
  }

  .source-actions {
    @apply flex flex-wrap gap-4 mt-4 text-sm font-medium;
  }

  .source-actions a {
    @apply text-blue-600 hover:text-blue-800 underline underline-offset-4;
  }

  .notebook-cells {
    @apply space-y-4;
  }

  .notebook-cell {
    @apply border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm;
  }

  .cell-code {
    @apply border-l-4 border-l-blue-500;
  }

  .cell-markdown {
    @apply border-l-4 border-l-green-500;
  }

  .cell-raw {
    @apply border-l-4 border-l-gray-500;
  }

  .input-header,
  .output-header {
    @apply flex items-center justify-between px-4 py-2 bg-gray-50 border-b border-gray-200;
  }

  .execution-count,
  .output-header {
    @apply text-sm font-mono text-blue-600;
  }

  .copy-button {
    @apply px-2 py-1 text-xs text-gray-500 hover:text-gray-800;
  }

  .code-content {
    @apply p-4 bg-gray-50 text-sm font-mono leading-relaxed overflow-x-auto whitespace-pre;
  }

  .output-content {
    @apply p-4 space-y-3;
  }

  .output-text,
  .output-json {
    @apply text-sm font-mono bg-gray-100 p-3 rounded whitespace-pre-wrap overflow-x-auto;
  }

  .output-html {
    @apply prose prose-sm max-w-none overflow-x-auto;
  }

  .output-image {
    @apply max-w-full h-auto rounded border border-gray-200;
  }

  .output-error {
    @apply text-sm font-mono text-red-800 bg-red-50 border border-red-200 rounded p-3 whitespace-pre-wrap overflow-x-auto;
  }

  .output-unsupported {
    @apply text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded p-3;
  }

  .markdown-content {
    @apply p-6 text-gray-800;
  }

  .raw-content {
    @apply p-4 bg-gray-50 text-sm font-mono text-gray-700 whitespace-pre-wrap overflow-x-auto;
  }

  .notebook-metadata {
    @apply mt-8 p-4 bg-gray-50 rounded-lg text-sm;
  }

  .notebook-metadata pre {
    @apply mt-3 overflow-x-auto;
  }

  @media (max-width: 768px) {
    .code-content,
    .output-text,
    .output-json,
    .output-error {
      @apply text-xs;
    }

    .markdown-content {
      @apply p-4;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLSpanElement>('.copy-label');
      try {
        await navigator.clipboard.writeText(button.dataset.code ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  });
</script>
