---
import SimpleNotebookViewer from '@/components/notebook/SimpleNotebookViewer.astro';
import type { ParsedNotebook } from '@/utils/notebook-parser';

export interface Props {
  notebook: ParsedNotebook;
  title?: string;
  sourceUrl?: string;
  showExecutionCount?: boolean;
  showMetadata?: boolean;
}

const {
  notebook,
  title,
  sourceUrl,
  showExecutionCount = true,
  showMetadata = false,
} = Astro.props;
---

<SimpleNotebookViewer
  notebook={notebook}
  title={title}
  sourceUrl={sourceUrl}
  showExecutionCount={showExecutionCount}
  showMetadata={showMetadata}
/>
