---
import { METADATA, type MetaData } from '@/config/site';
import { siteConfig } from '@/utils/site-config';

export interface Props extends MetaData {}

const {
  title = siteConfig.title,
  ignoreTitleTemplate = false,
  description = siteConfig.description,
  keywords = METADATA.keywords,
  canonical = Astro.url.pathname,
  robots = METADATA.robots,
  image,
  openGraph = {},
  twitter = {},
} = Astro.props;

const siteUrl = Astro.site || new URL(siteConfig.url);
const canonicalUrl = new URL(canonical, siteUrl);
const imageUrl = image ? new URL(image, siteUrl) : undefined;
const seoTitle = ignoreTitleTemplate || title === siteConfig.title
  ? title
  : METADATA.title.template.replace('%s', title);
const robotsContent = [robots.index ? 'index' : 'noindex', robots.follow ? 'follow' : 'nofollow'].join(', ');
const openGraphData = { ...METADATA.openGraph, ...openGraph };
const twitterData = { ...METADATA.twitter, ...twitter };
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{seoTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="robots" content={robotsContent} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#030620" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={openGraphData.type} />
<meta property="og:url" content={openGraphData.url || canonicalUrl} />
<meta property="og:site_name" content={openGraphData.siteName} />
<meta property="og:locale" content={openGraphData.locale} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
{imageUrl && <meta property="og:image" content={imageUrl} />}

<meta name="twitter:card" content={twitterData.cardType} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
{twitterData.handle && <meta name="twitter:creator" content={twitterData.handle} />}
{twitterData.site && <meta name="twitter:site" content={twitterData.site} />}
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
