---
import { METADATA, type MetaData } from '@/config/site';
import { siteConfig } from '@/utils/site-config';

export interface Props extends MetaData {}

const defaultImage = METADATA.image.src;
const defaultImageAlt = METADATA.image.alt;
const {
  title = siteConfig.title,
  ignoreTitleTemplate = false,
  description = siteConfig.description,
  keywords = METADATA.keywords,
  robots = METADATA.robots,
  image = defaultImage,
  openGraph = {},
  article,
} = Astro.props;

const siteUrl = Astro.site || new URL(siteConfig.url);
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const baseUrl = new URL(basePath, siteUrl);
const baseWithoutTrailingSlash = basePath.replace(/\/$/, '');
const withBase = (value: string) => {
  if (!value.startsWith('/') || value.startsWith('//') || basePath === '/') return value;
  if (value === baseWithoutTrailingSlash) return basePath;
  if (value.startsWith(basePath)) return value;
  return `${baseWithoutTrailingSlash}${value}`;
};
const toAbsoluteUrl = (value: string | URL, includeBase = true) => {
  if (includeBase && typeof value === 'string') {
    if (value.startsWith('/') && !value.startsWith('//')) return new URL(withBase(value), siteUrl);
    return new URL(value, baseUrl);
  }
  return new URL(value, siteUrl);
};
const currentPathname = Astro.url.pathname === baseWithoutTrailingSlash ? basePath : Astro.url.pathname;
const canonicalUrl = toAbsoluteUrl(currentPathname, false);
canonicalUrl.search = '';
canonicalUrl.hash = '';
const imageUrl = image ? toAbsoluteUrl(image) : undefined;
const resolvedImageAlt = image === defaultImage ? defaultImageAlt : `${title}：${description}`;
const seoTitle = ignoreTitleTemplate || title === siteConfig.title
  ? title
  : METADATA.title.template.replace('%s', title);
const robotsContent = [robots.index ? 'index' : 'noindex', robots.follow ? 'follow' : 'nofollow'].join(', ');
const openGraphData = { ...METADATA.openGraph, ...openGraph };
const rssUrl = toAbsoluteUrl('/rss.xml');
const articleJsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.publishedTime.toISOString(),
  ...(article.modifiedTime && { dateModified: article.modifiedTime.toISOString() }),
  author: { '@type': 'Person', name: article.author ?? siteConfig.author },
  url: canonicalUrl.href,
  // The site-wide fallback image does not represent the article, so only page-specific images are claimed.
  ...(imageUrl && image !== defaultImage && { image: imageUrl.href }),
};
// Escape HTML-significant characters so frontmatter strings cannot close the <script> element.
const serializeJsonLd = (data: object) =>
  JSON.stringify(data).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{seoTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="robots" content={robotsContent} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#030620" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={rssUrl} />

<meta property="og:type" content={openGraphData.type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={openGraphData.siteName} />
<meta property="og:locale" content={openGraphData.locale} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
{imageUrl && (
  <>
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={resolvedImageAlt} />
  </>
)}
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<meta name="twitter:card" content={METADATA.twitter.cardType} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && (
  <>
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />
  </>
)}
{articleJsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(articleJsonLd)} />}
