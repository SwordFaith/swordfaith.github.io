---
import type { MetaData } from '@/config/site';
import { SITE_DESCRIPTION } from '@/utils/site-config';
import PageLayout from '@/components/layout/PageLayout.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  image?: string;
  metadata?: MetaData;
  searchable?: boolean;
}

const { title, description = SITE_DESCRIPTION, keywords, image, metadata = {}, searchable } = Astro.props;
const mergedMetadata: MetaData = {
  title,
  description,
  keywords,
  image,
  ...metadata,
};
---

<PageLayout metadata={mergedMetadata} searchable={searchable}>
  <slot />
</PageLayout>
