---
import { I18N, UI, type MetaData } from '@/config/site';
import Metadata from '@/components/layout/Metadata.astro';
import '@/assets/styles/astrowind.css';
import 'katex/dist/katex.min.css';

export interface Props {
  metadata?: MetaData;
}

const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang={I18N.language} dir={I18N.textDirection} class="scroll-smooth" data-aw-theme={UI.theme}>
  <head>
    <Metadata {...metadata} />
    <script is:inline>
      (() => {
        const applyTheme = (theme) => {
          const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.awTheme = theme;
        };
        const savedTheme = localStorage.getItem('aw-theme');
        const legacyTheme = localStorage.getItem('theme');
        const isValidTheme = (theme) => theme === 'light' || theme === 'dark' || theme === 'system';
        const initialTheme = isValidTheme(savedTheme) ? savedTheme : isValidTheme(legacyTheme) ? legacyTheme : 'system';
        localStorage.setItem('aw-theme', initialTheme);
        localStorage.setItem('theme', initialTheme);
        applyTheme(initialTheme);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-page font-sans text-page antialiased">
    <a href="#main-content" class="sr-only z-[100] bg-page px-4 py-2 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">
      跳转到主要内容
    </a>
    <slot />
  </body>
</html>
