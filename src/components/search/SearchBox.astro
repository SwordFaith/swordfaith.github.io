---
export interface Props {
  placeholder?: string;
  className?: string;
}

const { placeholder = '搜索文章、笔记...', className = '' } = Astro.props;
---

<div class={`relative ${className}`} data-search-root>
  <label class="sr-only" for="search-input">搜索站内内容</label>
  <div class="relative">
    <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
    </svg>
    <input
      type="search"
      id="search-input"
      class="block w-full rounded-full border border-gray-300 bg-white py-3 pl-10 pr-4 text-sm text-page placeholder-gray-500 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/30 dark:border-slate-700 dark:bg-slate-900 dark:placeholder-gray-400"
      placeholder={placeholder}
      autocomplete="off"
      data-search-input
    />
  </div>
  <div id="search-results" role="region" aria-label="搜索结果" class="absolute z-50 mt-2 hidden max-h-96 w-full overflow-y-auto rounded-xl border border-gray-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900" data-search-results>
    <p class="hidden p-4 text-center text-sm text-muted" data-search-loading role="status">搜索中...</p>
    <div class="divide-y divide-gray-100 dark:divide-slate-800" data-search-content></div>
    <p class="hidden p-4 text-center text-sm text-muted" data-search-empty role="status">未找到相关内容</p>
  </div>
</div>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: {
      title?: string;
      date?: string;
    };
  }

  interface PagefindSearchResult {
    results: Array<{
      data: () => Promise<PagefindResultData>;
    }>;
  }

  interface PagefindModule {
    init?: () => void | Promise<void>;
    search: (query: string) => Promise<PagefindSearchResult>;
  }

  let pagefindPromise: Promise<PagefindModule> | undefined;

  const loadPagefind = () => {
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        const pagefindPath = '/pagefind/pagefind.js';
        const pagefind = await import(/* @vite-ignore */ pagefindPath) as PagefindModule;
        await pagefind.init?.();
        return pagefind;
      })();
    }
    return pagefindPromise;
  };

  document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    const loading = root.querySelector<HTMLElement>('[data-search-loading]');
    const content = root.querySelector<HTMLElement>('[data-search-content]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    if (!input || !results || !loading || !content || !empty) return;

    let searchTimeout: ReturnType<typeof setTimeout> | undefined;
    let requestId = 0;

    const setExpanded = (expanded: boolean) => {
      results.classList.toggle('hidden', !expanded);
    };

    const renderResults = (items: PagefindResultData[]) => {
      content.replaceChildren();
      items.forEach((item) => {
        const link = document.createElement('a');
        link.href = item.url;
        link.className = 'group block rounded-lg p-4 hover:bg-gray-50 focus:bg-gray-50 focus:outline-none dark:hover:bg-slate-800 dark:focus:bg-slate-800';

        const title = document.createElement('span');
        title.className = 'mb-1 block font-semibold text-page group-hover:text-primary';
        title.textContent = item.meta.title || item.url;

        const excerpt = document.createElement('span');
        excerpt.className = 'line-clamp-2 block text-sm leading-relaxed text-muted';
        excerpt.innerHTML = item.excerpt;

        link.append(title, excerpt);
        content.append(link);
      });
      loading.classList.add('hidden');
      empty.classList.toggle('hidden', items.length > 0);
      setExpanded(true);
    };

    const performSearch = async (query: string) => {
      const currentRequest = ++requestId;
      loading.classList.remove('hidden');
      empty.classList.add('hidden');
      content.replaceChildren();
      setExpanded(true);

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.search(query);
        const items = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
        if (currentRequest === requestId) renderResults(items);
      } catch (error) {
        console.warn('Pagefind is unavailable. Run npm run build to create the search index.', error);
        if (currentRequest === requestId) renderResults([]);
      }
    };

    input.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      const query = input.value.trim();
      if (query.length < 2) {
        requestId += 1;
        setExpanded(false);
        return;
      }
      searchTimeout = setTimeout(() => performSearch(query), 250);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setExpanded(false);
        input.blur();
      }
      if (event.key === 'ArrowDown') {
        const firstResult = content.querySelector<HTMLAnchorElement>('a');
        if (firstResult) {
          event.preventDefault();
          firstResult.focus();
        }
      }
    });

    input.addEventListener('focus', () => {
      if (content.childElementCount > 0) setExpanded(true);
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) setExpanded(false);
    });
  });
</script>
