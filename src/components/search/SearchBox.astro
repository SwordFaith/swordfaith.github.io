---
export interface Props {
  id?: string;
  placeholder?: string;
  className?: string;
  layout?: 'dropdown' | 'inline';
  limit?: number;
  initialQuery?: string;
  syncUrl?: boolean;
}

const {
  id = 'site-search',
  placeholder = '搜索博客文章和 Notebook...',
  className = '',
  layout = 'dropdown',
  limit = 8,
  initialQuery = '',
  syncUrl = false,
} = Astro.props;

const inputId = `${id}-input`;
const resultsId = `${id}-results`;
const statusId = `${id}-status`;
---

<div
  class={`relative ${className}`}
  data-search-root
  data-pagefind-ignore
  data-search-layout={layout}
  data-search-limit={limit}
  data-search-sync-url={syncUrl ? 'true' : undefined}
>
  <form action="/search/" method="get" role="search" class="relative">
    <label class="sr-only" for={inputId}>搜索博客文章和 Notebook</label>
    <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
    </svg>
    <input
      type="search"
      id={inputId}
      name="q"
      value={initialQuery}
      class="block w-full rounded-full border border-gray-300 bg-white py-3 pl-10 pr-4 text-sm text-page placeholder-gray-500 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/30 dark:border-slate-700 dark:bg-slate-900 dark:placeholder-gray-400"
      placeholder={placeholder}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-controls={resultsId}
      aria-describedby={statusId}
      data-search-input
    />
  </form>

  <div
    id={resultsId}
    role="region"
    aria-label="搜索结果"
    tabindex={layout === 'dropdown' ? -1 : undefined}
    class:list={[
      layout === 'dropdown'
        ? 'absolute left-0 right-0 z-[60] mt-2 hidden max-h-[70vh] overflow-y-auto rounded-xl border border-gray-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900'
        : 'mt-8 min-h-32 rounded-2xl border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 sm:p-6',
    ]}
    data-search-results
  >
    <p class="p-4 text-center text-sm text-muted" data-search-idle>输入至少 2 个字符开始搜索</p>
    <p class="hidden p-4 text-center text-sm text-muted" data-search-loading>正在搜索...</p>
    <p class="hidden p-4 text-center text-sm text-muted" data-search-empty>未找到相关内容，请尝试其他关键词</p>
    <div class="hidden p-4 text-center" data-search-error role="alert">
      <p class="text-sm text-muted">搜索服务暂时不可用，请稍后重试</p>
      <button type="button" class="mt-3 rounded-lg px-4 py-2 text-sm font-medium text-primary hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:hover:bg-primary-900/20" data-search-retry>
        重试
      </button>
    </div>
    <div class="divide-y divide-gray-100 dark:divide-slate-800" data-search-content></div>
  </div>
  <p id={statusId} class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-search-status></p>
</div>

<script>
  let pagefindPromise: Promise<PagefindModule> | undefined;

  const loadPagefind = () => {
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        const pagefindPath = '/pagefind/pagefind.js';
        const pagefind = await import(/* @vite-ignore */ pagefindPath) as PagefindModule;
        await pagefind.init?.();
        return pagefind;
      })().catch((error: unknown) => {
        pagefindPromise = undefined;
        throw error;
      });
    }
    return pagefindPromise;
  };

  document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const form = root.querySelector<HTMLFormElement>('form');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    const idle = root.querySelector<HTMLElement>('[data-search-idle]');
    const loading = root.querySelector<HTMLElement>('[data-search-loading]');
    const content = root.querySelector<HTMLElement>('[data-search-content]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    const error = root.querySelector<HTMLElement>('[data-search-error]');
    const retry = root.querySelector<HTMLButtonElement>('[data-search-retry]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    if (!input || !form || !results || !idle || !loading || !content || !empty || !error || !retry || !status) return;

    const isInline = root.dataset.searchLayout === 'inline';
    const parsedLimit = Number.parseInt(root.dataset.searchLimit || '8', 10);
    const resultLimit = Number.isFinite(parsedLimit) && parsedLimit > 0 ? parsedLimit : 8;
    let searchTimeout: ReturnType<typeof setTimeout> | undefined;
    let requestId = 0;

    const setResultsVisible = (visible: boolean) => {
      results.classList.toggle('hidden', !(isInline || visible));
    };

    const cancelSearch = () => {
      clearTimeout(searchTimeout);
      searchTimeout = undefined;
      return ++requestId;
    };

    const setState = (state: 'idle' | 'loading' | 'results' | 'empty' | 'error', message = '') => {
      idle.classList.toggle('hidden', state !== 'idle');
      loading.classList.toggle('hidden', state !== 'loading');
      empty.classList.toggle('hidden', state !== 'empty');
      error.classList.toggle('hidden', state !== 'error');
      results.setAttribute('aria-busy', String(state === 'loading'));
      status.textContent = message;
    };

    const resultLinks = () => Array.from(content.querySelectorAll<HTMLAnchorElement>('a'));

    const syncQuery = (query: string) => {
      if (root.dataset.searchSyncUrl !== 'true') return;
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const renderResults = (items: PagefindResultData[], total: number, query: string) => {
      content.replaceChildren();
      items.forEach((item) => {
        const link = document.createElement('a');
        link.href = item.url;
        link.className = 'group block rounded-lg p-4 hover:bg-gray-50 focus:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:hover:bg-slate-800 dark:focus:bg-slate-800';

        const title = document.createElement('span');
        title.className = 'mb-1 block font-semibold text-page group-hover:text-primary';
        title.textContent = item.meta.title || item.url;

        const excerpt = document.createElement('span');
        excerpt.className = 'line-clamp-3 block text-sm leading-relaxed text-muted [&_mark]:bg-primary-100 [&_mark]:text-page dark:[&_mark]:bg-primary-900/40';
        excerpt.innerHTML = item.excerpt;

        link.append(title, excerpt);
        content.append(link);
      });

      if (items.length === 0) {
        setState('empty', `没有找到与“${query}”相关的内容`);
      } else {
        const resultMessage = total > items.length
          ? `找到 ${total} 条结果，显示前 ${items.length} 条`
          : `找到 ${total} 条结果`;
        setState('results', resultMessage);
      }
    };

    const performSearch = async (query: string, currentRequest: number) => {
      try {
        const pagefind = await loadPagefind();
        if (currentRequest !== requestId) return;
        const search = await pagefind.search(query);
        if (currentRequest !== requestId) return;
        const items = await Promise.all(search.results.slice(0, resultLimit).map((result) => result.data()));
        if (currentRequest === requestId) renderResults(items, search.results.length, query);
      } catch (searchError) {
        if (currentRequest !== requestId) return;
        console.warn('Pagefind is unavailable. Run npm run build to create the search index.', searchError);
        setState('error', '搜索服务暂时不可用，请稍后重试');
      }
    };

    const startSearch = (query: string, delay = 0) => {
      // Invalidate the previous search as soon as the query changes, including during debounce.
      const currentRequest = cancelSearch();
      content.replaceChildren();
      setState('loading', `正在搜索“${query}”`);
      setResultsVisible(true);
      if (delay > 0) {
        searchTimeout = setTimeout(() => {
          searchTimeout = undefined;
          void performSearch(query, currentRequest);
        }, delay);
      } else {
        void performSearch(query, currentRequest);
      }
    };

    const resetSearch = () => {
      cancelSearch();
      content.replaceChildren();
      setState('idle');
      setResultsVisible(false);
    };

    const dismissDropdown = () => {
      if (isInline || results.classList.contains('hidden')) return;
      cancelSearch();
      if (!loading.classList.contains('hidden')) setState('idle');
      setResultsVisible(false);
    };

    input.addEventListener('input', () => {
      const query = input.value.trim();
      syncQuery(query);
      if (query.length < 2) resetSearch();
      else startSearch(query, 250);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !event.isComposing) {
        if (isInline ? event.target === input : results.classList.contains('hidden')) return;
        event.preventDefault();
        // Restore focus while the input's focus handler can still see the open dropdown.
        input.focus();
        dismissDropdown();
      }
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        const firstResult = resultLinks()[0];
        if (firstResult && !results.classList.contains('hidden')) {
          event.preventDefault();
          firstResult.focus();
        }
      }
    });

    content.addEventListener('keydown', (event) => {
      const links = resultLinks();
      const currentIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown' && currentIndex >= 0) {
        event.preventDefault();
        links[Math.min(currentIndex + 1, links.length - 1)]?.focus();
      }
      if (event.key === 'ArrowUp' && currentIndex >= 0) {
        event.preventDefault();
        if (currentIndex === 0) input.focus();
        else links[currentIndex - 1]?.focus();
      }
    });

    if (!isInline) {
      const reopenDropdown = () => {
        const query = input.value.trim();
        if (query.length < 2 || !results.classList.contains('hidden')) return;
        if (idle.classList.contains('hidden')) setResultsVisible(true);
        else startSearch(query);
      };

      input.addEventListener('focus', reopenDropdown);
      input.addEventListener('click', reopenDropdown);
      root.addEventListener('search:dismiss', dismissDropdown);
      root.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !root.contains(event.relatedTarget)) dismissDropdown();
      });
      document.addEventListener('pointerdown', (event) => {
        if (!root.contains(event.target as Node)) dismissDropdown();
      });
    }

    form.addEventListener('submit', (event) => {
      if (input.value.trim().length < 2) {
        event.preventDefault();
        resetSearch();
        input.focus();
      }
    });

    retry.addEventListener('click', () => {
      const query = input.value.trim();
      if (query.length >= 2) {
        input.focus();
        startSearch(query);
      }
    });

    const urlQuery = root.dataset.searchSyncUrl === 'true'
      ? new URL(window.location.href).searchParams.get('q')?.trim()
      : undefined;
    const initialQuery = urlQuery ?? input.value.trim();
    if (urlQuery !== undefined) input.value = initialQuery;
    if (initialQuery.length >= 2) startSearch(initialQuery);
    else resetSearch();
  });
</script>
