---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SinglePost from '@/components/blog/SinglePost.astro';
import PageLayout from '@/components/layout/PageLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf() || a.id.localeCompare(b.id),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: posts[index - 1],
      nextPost: posts[index + 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const metadata = {
  title: post.data.title,
  description: post.data.description,
  keywords: post.data.tags,
  image: post.data.cover,
  openGraph: {
    type: 'article',
  },
};
---

<PageLayout metadata={metadata}>
  <SinglePost post={post} headings={headings} previousPost={previousPost} nextPost={nextPost}>
    <Content />
  </SinglePost>
</PageLayout>

<style>
  .prose :where(table):not(:where([class~='not-prose'] *)) {
    @apply w-full border-collapse border border-gray-300 dark:border-gray-600;
  }

  .prose :where(th):not(:where([class~='not-prose'] *)) {
    @apply border border-gray-300 bg-gray-50 p-2 text-left font-semibold dark:border-gray-600 dark:bg-gray-800;
  }

  .prose :where(td):not(:where([class~='not-prose'] *)) {
    @apply border border-gray-300 p-2 dark:border-gray-600;
  }

  .katex-display {
    @apply my-6 overflow-x-auto;
  }
</style>
