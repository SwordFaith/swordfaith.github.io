---
import { getPublishedPosts } from '@/utils/posts';
import List from '@/components/blog/List.astro';
import PostTags from '@/components/blog/PostTags.astro';
import PageLayout from '@/components/layout/PageLayout.astro';
import SearchBox from '@/components/search/SearchBox.astro';
import Headline from '@/components/ui/Headline.astro';
import WidgetWrapper from '@/components/ui/WidgetWrapper.astro';

const sortedPosts = await getPublishedPosts();
const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags))].sort();

const metadata = {
  title: '技术博客',
  description: 'LLM 算法工程师的技术博客，分享后训练、强化学习算法、框架和数据研发的深度见解',
};
---

<PageLayout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-4xl">
    <Headline
      tagline="Blog"
      title="技术博客"
      titleTag="h1"
      subtitle="深度分享 LLM 后训练、强化学习算法、框架开发和数据工程的实践经验"
      class="mb-10"
    />
    <div class="mx-auto mb-8 max-w-xl">
      <SearchBox placeholder="搜索文章、笔记..." />
    </div>
    {allTags.length > 0 && (
      <section class="mb-10 text-center" aria-labelledby="popular-tags">
        <h2 id="popular-tags" class="sr-only">热门标签</h2>
        <PostTags tags={allTags} class="justify-center" />
      </section>
    )}
    {sortedPosts.length > 0 ? <List posts={sortedPosts} /> : <p class="py-12 text-center text-lg text-muted">暂无博客文章，敬请期待...</p>}
  </WidgetWrapper>
</PageLayout>
