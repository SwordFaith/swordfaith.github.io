---
import { Image } from 'astro:assets';
import avatar from '@/assets/images/avatar.jpg';
import GitHubStats from '@/components/about/GitHubStats.astro';
import PageLayout from '@/components/layout/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import Headline from '@/components/ui/Headline.astro';
import WidgetWrapper from '@/components/ui/WidgetWrapper.astro';
import Features from '@/components/widgets/Features.astro';
import Hero from '@/components/widgets/Hero.astro';

const metadata = {
  title: '关于我',
  description: 'A researcher and builder focused on LLM post-training techniques, including RL, DPO, and SFT. Passionate about AI alignment and safety.',
};

const researchAreas = [
  {
    title: '后训练技术',
    description: 'RLHF、DPO、SFT、Constitutional AI 等对齐与后训练方法。',
    icon: 'sparkles' as const,
  },
  {
    title: '强化学习算法',
    description: 'PPO、SAC、DQN、Multi-agent RL 及大模型训练应用。',
    icon: 'bolt' as const,
  },
  {
    title: '分布式系统',
    description: '大规模训练与推理框架、模型与数据并行、混合精度训练。',
    icon: 'database' as const,
  },
  {
    title: '数据工程',
    description: '高质量训练数据构建、清洗预处理、偏好标注与数据增强。',
    icon: 'database' as const,
  },
];

// Citation counts are a Google Scholar snapshot; update citationSnapshotDate with them
const citationSnapshotDate = '2026-11';

const publications = [
  {
    title: 'MiniCPM: Unveiling the Potential of Small Language Models with Scalable Training Strategies',
    venue: 'arXiv preprint arXiv:2404.06395, 2024',
    stat: '1,002 citations',
    authors: 'S Hu, Y Tu, X Han, C He, G Cui, X Long, Z Zheng, Y Fang, Y Huang, et al.',
    description: 'Introduces MiniCPM, a series of end-side language models with 1.2B and 2.4B non-embedding parameters; the 2.4B model significantly outperforms Llama2-7B on comprehensive benchmarks. This work demonstrates efficient training strategies for small-scale language models that achieve strong performance through innovative architectural designs and training methodologies.',
  },
  {
    title: 'MiniCPM4: Ultra-Efficient LLMs on End Devices',
    venue: 'arXiv preprint arXiv:2506.07900, 2025',
    stat: '75 citations',
    authors: 'M Team, C Xiao, Y Li, X Han, Y Bai, J Cai, H Chen, W Chen, X Cong, ..., X Long, et al.',
    description: 'Introduces MiniCPM4, a highly efficient LLM for end-side devices released in 0.5B and 8B versions, built through systematic innovation in model architecture (InfLLM v2 sparse attention), training data, training algorithms and inference systems (CPM.cu).',
  },
  {
    title: 'IntTower: The Next Generation of Two-Tower Model for Pre-ranking System',
    venue: 'Proceedings of the 31st ACM International Conference on Information & Knowledge Management, 2022',
    stat: '56 citations',
    authors: 'X Li, B Chen, HF Guo, J Li, C Zhu, X Long, S Li, Y Wang, W Guo, L Mao, et al.',
    description: 'Proposes IntTower, a novel two-tower architecture for large-scale pre-ranking systems that significantly improves efficiency and accuracy in recommendation systems through innovative interaction modeling techniques.',
  },
  {
    title: 'Exploring Text-Transformers in AAAI 2021 Shared Task: Covid-19 Fake News Detection in English',
    venue: 'International Workshop on Combating Online Hostile Posts in Regional Languages, 2021',
    stat: '64 citations',
    authors: 'X Li, Y Xia, X Long, Z Li, S Li',
    description: 'Develops an ensemble of pre-trained transformer models for COVID-19 fake news detection, placing 3rd in the AAAI 2021 shared task with a weighted F1 score of 0.9859 on the test set.',
  },
  {
    title: 'FenceMask: A Data Augmentation Approach for Pre-extracted Image Features',
    venue: 'arXiv preprint arXiv:2006.07877, 2020',
    stat: '48 citations',
    authors: 'P Li, X Li, X Long',
    description: 'Introduces FenceMask, a novel data augmentation technique for pre-extracted image features that improves model robustness and generalization in computer vision tasks.',
  },
  {
    title: 'Low Resource Style Transfer via Domain Adaptive Meta Learning',
    venue: 'NAACL 2022 (oral), arXiv:2205.12475',
    stat: '14 citations',
    authors: 'X Li, X Long, Y Xia, S Li',
    description: 'Addresses the challenge of style transfer in low-resource settings using domain adaptive meta learning techniques.',
  },
  {
    title: 'KDD CUP 2021 MAG240M-LSC Team Passages Winner Solution',
    venue: 'KDD CUP 2021 Competition, 2021',
    stat: 'Winner',
    authors: 'K Li, X Long, Z Feng, M Wang, X Liu, P Wang, Q Lin, K Zhao, B Ai',
    description: 'Winning solution for the KDD CUP 2021 MAG240M-LSC challenge, demonstrating excellence in large-scale graph learning and academic paper analysis.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero
    compact
    tagline="About"
    title="Xiang Long (SwordFaith)"
    subtitle="大语言模型后训练技术研究员和算法工程师"
    actions={[
      { text: '发送邮件', href: 'mailto:mid.of.change@gmail.com', variant: 'primary' },
      { text: 'GitHub', href: 'https://github.com/SwordFaith', variant: 'secondary', target: '_blank' },
    ]}
  >
    <Image
      slot="image"
      src={avatar}
      width={128}
      height={128}
      densities={[1, 2]}
      loading="eager"
      alt="Xiang Long Profile Photo"
      class="mx-auto mb-6 h-32 w-32 rounded-full border-4 border-white object-cover shadow-lg dark:border-slate-700"
    />
  </Hero>

  <WidgetWrapper padding="sm" containerClass="max-w-3xl">
    <Headline title="个人简介" align="left" class="mb-6" />
    <div class="space-y-4 text-lg leading-relaxed text-muted">
      <p>我是一位专注于大语言模型后训练技术的算法工程师和研究员，主要研究方向包括强化学习从人类反馈（RLHF）、直接偏好优化（DPO）、监督式微调（SFT）等后训练方法。在分布式训练框架开发和高质量数据构建方面有丰富经验。</p>
      <p>致力于通过技术创新推动 AI 系统的对齐和安全性，让大语言模型更好地服务于人类社会。</p>
    </div>
  </WidgetWrapper>

  <Features title="研究方向" subtitle="从算法研究到训练框架与数据工程的完整实践" items={researchAreas} columns={2} />

  <WidgetWrapper bg="primary" containerClass="max-w-4xl">
    <Headline tagline="Publications" title="发表工作" class="mb-10" />
    <div class="space-y-6">
      {publications.map((publication) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <h3 class="mb-3 text-lg font-semibold leading-relaxed text-page">{publication.title}</h3>
          <p class="mb-2 text-sm text-muted">
            {publication.venue}
            {publication.stat && <span class="ml-2 font-semibold text-primary">| {publication.stat}</span>}
          </p>
          <p class="mb-3 text-sm text-muted"><strong>Authors:</strong> {publication.authors}</p>
          <p class="leading-relaxed text-muted">{publication.description}</p>
        </article>
      ))}
    </div>
    <div class="mt-8 text-center text-muted">
      <p class="mb-4"><strong>Citation Statistics:</strong> 1,324 total citations | h-index: 9 | i10-index: 9 <span class="text-sm">(Google Scholar, as of {citationSnapshotDate})</span></p>
      <a href="https://scholar.google.com/citations?user=Fz855UwAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="link-primary">View Full Google Scholar Profile →</a>
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-5xl">
    <GitHubStats username="SwordFaith" showContributions showLanguages showRepositories maxRepos={2} />
  </WidgetWrapper>

  <WidgetWrapper bg="transparent" padding="sm">
    <Headline title="联系方式" subtitle="如果您对我的研究工作感兴趣，或者想要合作交流，欢迎联系我。" class="mb-8" />
    <div class="text-center">
      <Button variant="primary" size="lg" href="mailto:mid.of.change@gmail.com">mid.of.change@gmail.com</Button>
    </div>
  </WidgetWrapper>
</PageLayout>
