---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import NotebookViewer from '@/components/notebook/NotebookViewer.astro';
import { NotebookParser } from '@/utils/notebook-parser';

export async function getStaticPaths() {
  const notebooks = await getCollection('notebooks');
  return notebooks.map((notebook) => ({
    params: { slug: notebook.id },
    props: notebook,
  }));
}

type Props = CollectionEntry<'notebooks'>;

const notebook = Astro.props;
const parsedNotebook = await NotebookParser.loadNotebook(notebook.data.notebookPath);
---

<BaseLayout
  title={notebook.data.title}
  description={notebook.data.description}
  keywords={notebook.data.tags}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 text-center">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-gray-600 mb-4">
        <time datetime={notebook.data.publishDate.toISOString()}>
          {notebook.data.publishDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{notebook.data.author}</span>
        {notebook.data.tags.slice(0, 3).map((tag) => (
          <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">{tag}</span>
        ))}
      </div>
    </div>

    <NotebookViewer
      notebook={parsedNotebook}
      title={notebook.data.title}
      sourceUrl={notebook.data.notebookPath}
    />

    <nav class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex justify-between items-center">
        <a href="/notebooks" class="text-blue-600 hover:text-blue-700 font-medium flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回 Notebooks 列表
        </a>
        <button class="text-gray-600 hover:text-gray-900 flex items-center" onclick="window.print()">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          打印
        </button>
      </div>
    </nav>
  </div>
</BaseLayout>
