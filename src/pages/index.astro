---
import { getCollection } from 'astro:content';
import PageLayout from '@/components/layout/PageLayout.astro';
import Hero from '@/components/widgets/Hero.astro';
import Features from '@/components/widgets/Features.astro';
import BlogLatestPosts from '@/components/widgets/BlogLatestPosts.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/utils/site-config';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = blogPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const metadata = {
  title: SITE_TITLE,
  ignoreTitleTemplate: true,
  description: SITE_DESCRIPTION,
};

const researchAreas = [
  {
    title: '后训练技术',
    description: 'RLHF、DPO、SFT 等后训练方法的研究与实现，提升模型对话能力和安全性。',
    icon: 'sparkles' as const,
  },
  {
    title: '强化学习算法',
    description: 'PPO、SAC、DQN 等强化学习算法在大语言模型训练中的应用与优化。',
    icon: 'bolt' as const,
  },
  {
    title: '框架与数据',
    description: '分布式训练框架开发，高质量训练数据构建与处理流程设计。',
    icon: 'database' as const,
  },
];
---

<PageLayout metadata={metadata}>
  <Hero
    tagline="学海无涯，进一寸有一寸的欢喜"
    title={SITE_TITLE}
    subtitle={SITE_DESCRIPTION}
    actions={[
      { text: '阅读博客', href: '/blog', variant: 'primary' },
      { text: '了解我', href: '/about', variant: 'secondary' },
    ]}
  />
  <Features
    tagline="Research"
    title="研究领域"
    subtitle="聚焦前沿技术，探索 LLM 训练与优化的最佳实践"
    items={researchAreas}
  />
  <BlogLatestPosts posts={recentPosts} />
</PageLayout>
