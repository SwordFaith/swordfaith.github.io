# Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# GitHub Configuration (Optional - for GitHub stats and repository info)
# =============================================================================
# Create a personal access token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-personal-access-token

# =============================================================================
# Site Configuration
# =============================================================================
# No environment variables. The site URL, title and description are set in
# src/config/site.ts (the `SITE` object), which astro.config.mjs also reads.

# =============================================================================
# Development Configuration
# =============================================================================
NODE_ENV=development

# =============================================================================
# Security Notes:
# - Never commit the actual .env file to version control
# - Keep your API keys secure and don't share them
# - Regenerate tokens if they're ever compromised
# - Use minimal required permissions for API tokens
# =============================================================================